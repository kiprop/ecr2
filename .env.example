# ---- App ----
APP_BASE_URL=https://dhda.pedaids.org
BASE_PATH=/ecr2
APP_PUBLISHED_PORT=8304
# openssl rand -hex 48
SESSION_SECRET=

# ---- Database (own container; set before first start, it cannot be changed later by editing this file) ----
DB_USER=ecr2
# openssl rand -hex 24
DB_PASSWORD=
DB_NAME=ecr2

# ---- Sign-in: Microsoft Entra (same app registration as gap-node) ----
AUTH_MODE=entra
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# Comma-separated @pedaids.org emails made administrators on their first sign-in
SUPER_ADMINS=

# ---- Optional: Microsoft Graph (application permissions + admin consent) ----
# Mailbox reminders are sent from (needs Mail.Send). Blank = reminders are logged only.
MAIL_SENDER=
# true = directory search on the invite page (needs User.Read.All)
DIRECTORY_SEARCH=false

# ---- Uploads and worker ----
MAX_UPLOAD_MB=25
WORKER_INTERVAL_MIN=60
