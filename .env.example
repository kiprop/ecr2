# ---- App ----
APP_BASE_URL=https://dhda.pedaids.org
BASE_PATH=/ecr2
APP_PUBLISHED_PORT=8304
# openssl rand -hex 48
SESSION_SECRET=

# ---- Database (own container; set before first start, it cannot be changed later by editing this file) ----
DB_USER=ecr2
# openssl rand -hex 24
DB_PASSWORD=
DB_NAME=ecr2

# ---- Sign-in: Microsoft Entra (same app registration as gap-node) ----
AUTH_MODE=entra
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# Comma-separated @pedaids.org emails made administrators on their first sign-in
SUPER_ADMINS=

# ---- Email (optional; with neither option set, reminders are logged only) ----
# Option A, SMTP: works if Authenticated SMTP is enabled for the mailbox in Microsoft 365
# and the account has no MFA prompt (a service mailbox). Test it from Settings › Send me a test email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=EGPAF Compliance Registry <gapsupport@pedaids.org>
# Option B, Microsoft Graph: mailbox to send as (needs Mail.Send application permission). Takes priority over SMTP.
MAIL_SENDER=

# ---- Optional: directory search on the invite page (needs Graph User.Read.All) ----
DIRECTORY_SEARCH=false

# ---- Uploads and worker ----
MAX_UPLOAD_MB=25
WORKER_INTERVAL_MIN=60
