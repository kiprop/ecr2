<a class="row" href="<%= bp %><%= withItem(o.id) %>">
  <% if (typeof lead !== 'undefined' && lead === 'seq') { %><span class="mono muted small" style="width:22px"><%= o.seq || '' %></span><% } %>
  <% if (typeof lead === 'undefined' || lead === 'status') { %><span class="chip fixed <%= o.chipCls %>"><%= o.statusLabel %></span><% } %>
  <span class="grow">
    <span class="title"><%= o.title %></span>
    <% if (typeof lead === 'undefined' || lead === 'status') { %><span class="meta"><%= (typeof showCountry !== 'undefined' && showCountry) ? o.country_name + ' · ' : '' %><%= o.areaLabel %> · <%= o.dueText %></span><% } %>
    <% if (o.status === 'returned' && o.review_note) { %><span class="meta" style="color:#7F420C">HQ: “<%= o.review_note %>”</span><% } %>
  </span>
  <% if (typeof lead !== 'undefined' && lead !== 'status') { %><span class="muted small" style="white-space:nowrap"><%= o.dueShort %></span><span class="chip fixed <%= o.chipCls %>"><%= o.statusLabel %></span><% } %>
  <% if (typeof lead === 'undefined' || lead === 'status') { %><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#8A939C" stroke-width="2" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg><% } %>
</a>
