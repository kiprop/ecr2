<% const o = drawer.o, back = drawer.closeHref; %>
<div class="overlay" role="dialog" aria-modal="true" aria-labelledby="drawer-title">
  <a class="scrim" href="<%= bp %><%= back %>" aria-label="Close" tabindex="-1"></a>
  <aside class="drawer">
    <div class="drawer-head">
      <div style="flex:1">
        <div class="label"><%= o.country_name %> · <%= o.areaLabel %><%= o.seq && (o.area === 'annual' || o.area === 'setup') ? ' · Item ' + o.seq : '' %></div>
        <h2 id="drawer-title" style="margin:6px 0 8px;font-size:20px"><%= o.title %></h2>
        <div class="row-flex" style="gap:8px"><span class="chip <%= o.chipCls %>"><%= o.statusLabel %></span><span class="muted small"><%= o.dueText %></span></div>
      </div>
      <a class="btn btn-ghost" href="<%= bp %><%= back %>" aria-label="Close" data-close><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg></a>
    </div>
    <div class="drawer-body">
      <div><div class="label">What is required</div><p style="margin:6px 0 0;font-size:15px;line-height:1.5"><%= o.requirement || o.title %></p></div>

      <% if (o.status === 'returned' && o.review_note) { %>
        <div class="notice notice-warn"><div style="font-weight:600;color:#7F420C">Returned by HQ</div><div style="margin-top:3px"><%= o.review_note %></div></div>
      <% } %>

      <% if (Object.keys(drawer.payload).length && !drawer.canSubmit) { %>
        <div class="grid-fields" style="grid-template-columns:repeat(auto-fit,minmax(180px,1fr))">
          <% const labels = {}; drawer.fields.forEach((f) => labels[f.k] = f.label); if (drawer.changeDef) drawer.changeDef.fields.forEach((f) => labels[f.k] = f.label); %>
          <% Object.entries(drawer.payload).filter(([k, v]) => v && labels[k] && !/_id$/.test(k)).forEach(([k, v]) => { %>
            <div><div class="label"><%= labels[k] %></div><div style="margin-top:3px"><%= /^\d{4}-\d{2}-\d{2}$/.test(v) ? d.fmtDate(v) : v %></div></div>
          <% }) %>
        </div>
      <% } %>

      <% if (drawer.docs.length) { %>
        <div class="stack-s" style="gap:8px">
          <div class="label">Documents</div>
          <% drawer.docs.forEach((doc) => { %>
            <div class="doc"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#0F5A64" stroke-width="2" aria-hidden="true"><path d="M14 3H6a1 1 0 0 0-1 1v16a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V8z"/><path d="M14 3v5h5"/></svg><span style="flex:1;min-width:0"><a href="<%= bp %>/documents/<%= doc.id %>"><%= doc.filename %></a><span class="muted small" style="display:block"><%= doc.label %> · <%= doc.by_name || '' %> · <%= d.fmtWhen(doc.uploaded_at) %></span></span></div>
          <% }) %>
        </div>
      <% } %>

      <% if (drawer.canSubmit) { %>
        <form method="post" action="<%= bp %>/items/<%= o.id %>/submit" enctype="multipart/form-data" class="stack-s" style="gap:14px">
          <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="returnTo" value="<%= back %>">
          <% drawer.fields.forEach((f) => { %>
            <label class="field"><%= f.label %>
              <% if (f.type === 'select') { %><select class="input" name="<%= f.k %>"><% f.options.forEach((op) => { %><option <%= drawer.payload[f.k] === op ? 'selected' : '' %>><%= op %></option><% }) %></select>
              <% } else { %><input class="input" type="<%= f.type %>" name="<%= f.k %>" value="<%= drawer.payload[f.k] || '' %>"><% } %>
            </label>
          <% }) %>
          <label class="field">Evidence<span class="file-drop"><input type="file" name="file" multiple></span></label>
          <% if (o.status === 'returned' && drawer.docs.length) { %><label class="check-row"><input type="checkbox" name="keep_docs" value="1">The documents already attached are enough</label><% } %>
          <label class="field">Note for the reviewer (optional)<textarea class="input" name="note" rows="2"></textarea></label>
          <div class="row-flex"><button class="btn btn-pri" type="submit">Submit for review</button></div>
        </form>
        <% if (drawer.canNA) { %>
          <form method="post" action="<%= bp %>/items/<%= o.id %>/na" class="row-flex">
            <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="returnTo" value="<%= back %>">
            <input class="input" name="note" placeholder="Why it does not apply this year" style="flex:1 1 220px">
            <button class="btn" type="submit">Not applicable this year</button>
          </form>
        <% } %>
      <% } %>

      <% if (drawer.canReview) { %>
        <form method="post" action="<%= bp %>/items/<%= o.id %>/accept" class="stack-s notice" style="background:#F6F7F7" id="review-form">
          <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="returnTo" value="<%= back %>">
          <label class="field">Comment (required to return)<textarea class="input" name="note" rows="2"></textarea></label>
          <div class="row-flex"><button class="btn btn-ok" type="submit">Accept</button><button class="btn btn-ret" type="submit" formaction="<%= bp %>/items/<%= o.id %>/return">Return to country</button></div>
        </form>
      <% } %>

      <% if (drawer.hqWaiting) { %>
        <div class="notice notice-info"><%= o.status === 'returned' ? 'Returned to the country office. It comes back here once they resubmit.' : 'Waiting for the country office. Once they submit evidence, Accept and Return appear here.' %></div>
        <div>
          <div class="label">Country team</div>
          <% if (drawer.team.length) { %>
            <div style="margin-top:6px;font-size:14px"><%= drawer.team.map((t) => t.name + (t.role === 'director' ? ' (Country Director)' : '')).join(', ') %></div>
          <% } else { %>
            <div class="notice notice-warn" style="margin-top:6px">No Country Director or focal point is assigned to <%= o.country_name %> yet. You can record this item for them below<% if (user.role === 'admin') { %>, or <a href="<%= bp %>/admin/users">assign someone in Users &amp; access</a><% } %>.</div>
          <% } %>
        </div>
        <% if (drawer.team.length && o.status === 'todo') { %>
          <form method="post" action="<%= bp %>/items/<%= o.id %>/remind" class="stack-s" style="gap:8px">
            <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="returnTo" value="<%= back %>">
            <input class="input" name="note" placeholder="Add a message (optional)">
            <div><button class="btn" type="submit">Send a reminder</button></div>
          </form>
        <% } %>
        <details <%= drawer.team.length ? '' : 'open' %>>
          <summary class="small" style="cursor:pointer;color:var(--pri);font-weight:600">Record it for the country</summary>
          <form method="post" action="<%= bp %>/items/<%= o.id %>/record" enctype="multipart/form-data" class="stack-s" style="gap:12px;margin-top:10px">
            <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="returnTo" value="<%= back %>">
            <div class="muted small">Marks it done with your evidence, as if submitted and accepted. Use it while the country team is not on ECR yet.</div>
            <% drawer.fieldsHQ.forEach((f) => { %>
              <label class="field"><%= f.label %>
                <% if (f.type === 'select') { %><select class="input" name="<%= f.k %>"><% f.options.forEach((op) => { %><option <%= drawer.payload[f.k] === op ? 'selected' : '' %>><%= op %></option><% }) %></select>
                <% } else { %><input class="input" type="<%= f.type %>" name="<%= f.k %>" value="<%= drawer.payload[f.k] || '' %>"><% } %>
              </label>
            <% }) %>
            <label class="field">Evidence<span class="file-drop"><input type="file" name="file" multiple></span></label>
            <% if (drawer.docs.length) { %><label class="check-row"><input type="checkbox" name="keep_docs" value="1">The documents already attached are enough</label><% } %>
            <label class="field">Note (optional)<input class="input" name="note"></label>
            <div><button class="btn btn-pri" type="submit">Record as done</button></div>
          </form>
          <% if (drawer.canNAhq) { %>
            <form method="post" action="<%= bp %>/items/<%= o.id %>/na" class="row-flex" style="margin-top:10px">
              <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="returnTo" value="<%= back %>">
              <input class="input" name="note" placeholder="Why it does not apply this year" style="flex:1 1 200px">
              <button class="btn" type="submit">Not applicable this year</button>
            </form>
          <% } %>
        </details>
        <% if (o.due_date) { %>
          <details>
            <summary class="small" style="cursor:pointer;color:var(--pri);font-weight:600">Change the due date for <%= o.country_name %></summary>
            <form method="post" action="<%= bp %>/items/<%= o.id %>/due" class="row-flex" style="margin-top:10px;gap:8px">
              <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="returnTo" value="<%= back %>">
              <input class="input" type="date" name="due_date" value="<%= o.due_date %>" required style="width:170px">
              <input class="input" name="note" placeholder="Why, e.g. statutory date is 31 March" style="flex:1 1 200px">
              <button class="btn btn-sm" type="submit">Save</button>
            </form>
          </details>
        <% } %>
      <% } else if (!drawer.canSubmit && !drawer.canReview) { %>
        <div class="notice notice-info"><%= o.status === 'submitted' ? 'Submitted. HQ will review it, and the outcome shows on the Home page.' : o.status === 'accepted' ? 'Accepted by HQ. Nothing more to do.' : o.status === 'na' ? 'Marked not applicable for this cycle.' : 'The country office has not submitted this yet.' %></div>
      <% } %>

      <div>
        <div class="label" style="margin-bottom:6px">Activity</div>
        <% drawer.events.forEach((e) => { %>
          <div class="event"><span class="when"><%= d.fmtWhen(e.at) %></span><span><b style="font-weight:600"><%= e.who || 'System' %></b> <span class="muted"><%= e.action.replace(/^item\./, '').replace(/[._]/g, ' ') %><%= e.detail && !/^(submitted with evidence|accepted)$/.test(e.detail) ? ': ' + e.detail : '' %></span></span></div>
        <% }) %>
        <% if (!drawer.events.length) { %><div class="muted small">No activity yet.</div><% } %>
      </div>
    </div>
  </aside>
</div>
