<%- include('partials/top') %>
<% const names = { registration: 'Registration', board: 'Board member', poa: 'Power of attorney', bank: 'Bank account' }; %>
<div class="stack" style="gap:18px;max-width:760px">
  <div><a class="small" href="<%= bp %><%= back %>">← <%= country.name %></a><h1 style="margin-top:4px"><%= rec.id === 'new' ? 'Add' : 'Edit' %>: <%= names[kind] %></h1><p class="sub">Direct register corrections by HQ. Every save is logged, and deadlines recalculate from these dates.</p></div>
  <form method="post" class="card pad stack-s" style="gap:14px">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <% fields.forEach(([k, label, t]) => { %>
      <% if (t === 'bool') { %><label class="check-row"><input type="checkbox" name="<%= k %>" <%= rec.data[k] ? 'checked' : '' %>><%= label %></label>
      <% } else { %><label class="field"><%= label %><input class="input" type="<%= t === 'date' ? 'date' : 'text' %>" name="<%= k %>" value="<%= rec.data[k] || '' %>"></label><% } %>
    <% }) %>
    <div class="row-flex">
      <button class="btn btn-pri" type="submit">Save</button>
      <a class="btn" href="<%= bp %><%= back %>">Cancel</a>
      <% if (rec.id !== 'new') { %><button class="btn btn-ret spacer" name="action" value="deactivate" data-confirm="Remove this record from the register? It stays in the history.">Remove from register</button><% } %>
    </div>
  </form>
</div>
<%- include('partials/bottom') %>
