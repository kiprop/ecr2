<%- include('partials/top') %>
<div class="stack" style="gap:18px">
  <div class="row-flex" style="justify-content:space-between;align-items:flex-end">
    <div><h1>Calendar</h1><p class="sub">Built from the registers and cycles. Change a date anywhere and it moves here.</p></div>
    <div class="row-flex">
      <button class="btn" type="button" data-copy="<%= calUrl %>">Copy Outlook subscription link</button>
      <a class="btn" href="<%= bp %>/calendar.csv<%= country !== 'all' ? '?country=' + country : '' %>">Export CSV</a>
    </div>
  </div>
  <% if (countries.length > 1) { %>
    <div class="pills"><a class="pill <%= country === 'all' ? 'on' : '' %>" href="<%= bp %>/calendar">All countries</a><% countries.forEach((c) => { %><a class="pill <%= country === c.code ? 'on' : '' %>" href="<%= bp %>/calendar?country=<%= c.code %>"><%= c.name %></a><% }) %></div>
  <% } %>
  <% groups.forEach((g) => { %>
    <section class="card overflow">
      <div class="list-head"><h2 style="font-size:16px"><%= g.name %></h2><span class="muted small"><%= g.items.length %> <%= g.items.length === 1 ? 'deadline' : 'deadlines' %></span></div>
      <% g.items.forEach((o) => { %>
        <a class="row" href="<%= bp %><%= withItem(o.id) %>">
          <span class="mono" style="width:58px;font-size:13.5px;font-weight:500"><%= d.fmtShort(o.due_date) %></span>
          <span class="grow"><span class="title" style="font-weight:400"><%= o.title %></span><span class="meta"><%= o.country_name %> · <%= o.areaLabel %></span></span>
          <span class="chip <%= o.chipCls %>"><%= o.statusLabel %></span>
        </a>
      <% }) %>
    </section>
  <% }) %>
  <% if (!groups.length) { %><div class="card empty">No open deadlines.</div><% } %>
</div>
<%- include('partials/bottom') %>
